<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Scan: read the link filters of all installed apps. Not a Play Store app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives links. The scan detects caught schemes itself (query against this activity).
             Generic http/https (no host) makes LinkSieve selectable as default browser. -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Translucent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="market" />
                <data android:scheme="intent" />
            </intent-filter>
            <!-- App deep links that ads use (from the scan). No system schemes (tel, mailto, sms, geo)
                 and no login/payment callbacks, those would break calls and sign-ins. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="amazonmobile" />
                <data android:scheme="amzn" />
                <data android:scheme="bahnsparer" />
                <data android:scheme="com.google.android.apps.youtube" />
                <data android:scheme="com.lidlplus.app" />
                <data android:scheme="disneyplus" />
                <data android:scheme="docmorris" />
                <data android:scheme="geizhals" />
                <data android:scheme="lidlplus" />
                <data android:scheme="lidlplus-app" />
                <data android:scheme="midiscover" />
                <data android:scheme="mimarket" />
                <data android:scheme="soundcloud" />
                <data android:scheme="spotify" />
                <data android:scheme="steammobile" />
                <data android:scheme="streamflix" />
                <data android:scheme="tunein" />
                <data android:scheme="tunein.player" />
                <data android:scheme="vnd.youtube" />
                <data android:scheme="vnd.youtube.launch" />
                <data android:scheme="wetteronline" />
                <data android:scheme="weixin" />
                <data android:scheme="whatsapp" />
            </intent-filter>
        </activity>

        <!-- App-start guard: dialog after an intercepted start. -->
        <activity
            android:name=".GuardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Translucent" />

        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>
    </application>
</manifest>
